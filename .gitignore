.archipelago/
.env
.godot/
__pycache__/
.pytest_cache/
*.tmp
*.bak
*.pyc
.venv/
saves/
# The pre-art playtest run's own save directory, kept apart from
# `saves/` so a baseline playtest cannot overwrite a real campaign.
playtest-2.5/
# ...and the 3A/3B checkpoint's, for the same reason. All three movement
# packages share it deliberately: the Zone is generated once and stored,
# so `none`, `rail` and `launch` are three visits to one level.
playtest-3ab/
# Diagnostic campaign slots. One folder per slot, never committed: they
# are somebody's save, and `.diagnostic-582e954` in particular is the
# owner's own and is not ours to publish.
.diagnostic-*/
# Where YOUR Godot lives. A fact about one machine, not about the
# project -- committing it hands everyone else a path that is not there.
godot-path.txt
.integration-saves/
.integration-saves-quiet/
.integration-saves-variant/
.journey-saves/
.reload-saves/
generation_archive/
godot-bin/

# Editable installs leave these behind; they are build output, not source.
*.egg-info/

# --- art lane -------------------------------------------------------------
# Toolchains fetched per session (Blender, Godot). See docs/art/ASSET_AUTHORING.md.
/.tools/
# Art review renders that are regenerated rather than reviewed. Committed
# review evidence lives in docs/art/review/ and is NOT ignored -- the owner
# has to be able to see it without running anything.
/.artpreview/

# Scratch JPEGs for tools/shots/make_review_pdf.py, rebuilt on demand.
.pdfcache/

# A non-default `--theme` build. Scratch by construction: it proves the
# pipeline can wear a second theme, it is not an asset. Nothing exports
# from here, nothing is reviewed here, and no manifest names it.
assets/themed/

# Layout manifests the declared sample emits for the bridge to judge.
# Regenerated by `make zone-sample` from the sample Zones; the evidence
# is the verdict, not the file.
godot/tests/fixtures/sample/layouts/
.named-case-saves/
