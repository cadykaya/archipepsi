+# --------------------------------------------------------------------------
+# D-07 (owner ruling, 2026-09-24): pressure plates are held sensors
+# --------------------------------------------------------------------------
+
+def _lever_route(*, latched: bool = True, edge_index: int = 0) -> dict:
+    """`lever -> LATCH -> shutter` (or a bare `lever -> shutter`) on one
+    edge of the composed Zone, as raw data for `Zone.model_validate`."""
+    raw = composed().model_dump()
+    edge = raw["edges"][edge_index]
+    raw["room_graphs"] = [{
+        "room_id": edge["room_a"],
+        "sensors": [{"node_id": "route_lever", "kind": "PULSE_BUTTON"}],
+        "nodes": ([{"node_id": "held", "kind": "LATCH",
+                    "inputs": ["route_lever"]}] if latched else []),
+        "actuators": [{"actuator_id": "route_shutter",
+                       "driven_by": "held" if latched else "route_lever"}],
+    }]
+    edge["opened_by"] = "route_shutter"
+    return raw
+
+
+def test_a_lever_route_is_certified_as_the_plate_route_was():
+    """Pulled once, let go: closed at rest, open after -- the same
+    arithmetic, and the same route search, as the plate it replaces."""
+    zone = Zone.model_validate(_lever_route())
+    assert reachability(zone).ok
+
+
+def test_a_lever_straight_to_a_shutter_is_a_held_requirement():
+    """A pulse is gone the tick after it arrives, so a shutter driven by
+    one directly would move for one tick -- a door no one could walk
+    through. Refused structurally, before the route rules are asked."""
+    with pytest.raises(ValueError, match="move for one tick"):
+        Zone.model_validate(_lever_route(latched=False))
+
+
+def test_a_save_composed_before_d07_still_loads():
+    """09 §PT-03: "Existing old saves must not become unreadable because a
+    new content validator disapproves their original declaration." The
+    step-once plate is refused where Zones are MADE, not where they load."""
+    zone = latched_route()
+    assert zone.room_graphs[0].sensors[0].kind == "PRESSURE_PLATE"
+    assert reachability(zone).ok
+
+
+def _plates_that_latch(zone) -> list[str]:
+    """Every plate a LATCH is fed from, in any room graph of `zone`."""
+    from archipepsi_bridge.schemas import signal_graph as SG
+    out = []
+    for graph in zone.room_graphs or ():
+        for actuator in graph.actuators:
+            sensors, nodes = SG.upstream(graph, actuator.actuator_id)
+            if any(n.kind == "LATCH" for n in nodes):
+                out += [f"{graph.room_id}/{s.node_id}" for s in sensors
+                        if s.kind == "PRESSURE_PLATE"]
+    return out
+
+
+def test_no_composition_emits_a_plate_that_latches():
+    """D-07: "A pressure plate must not permanently latch merely because
+    I stepped on it once." Over every Zone the composers make today: P14's
+    route on the played Zone, and the whole candidate profile."""
+    from archipepsi_bridge.playtest import (candidate_all_zone,
+                                            latched_route_zone)
+    for name, zone in (("latched route", latched_route_zone()),
+                       ("candidate profile", candidate_all_zone())):
+        assert zone is not None, f"the {name} composition declined"
+        assert _plates_that_latch(zone) == [], (name, _plates_that_latch(zone))
+
+
 def test_the_composer_does_not_stack_onto_a_zone_that_has_one():
     from archipepsi_bridge.latched_route import compose_latched_route
     once = compose_latched_route(composed())
