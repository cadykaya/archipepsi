    "ArenaChamber": {
      "additionalProperties": false,
      "description": "Rectangular combat room. A boss room is an arena holding one brute.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "anyOf": [
            {
              "maximum": 89100030,
              "minimum": 89100001,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Location Id"
        },
        "type": {
          "const": "arena",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "maximum": 28,
          "minimum": 10,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "maximum": 28,
          "minimum": 10,
          "title": "Depth",
          "type": "number"
        },
        "wall_height": {
          "maximum": 8,
          "minimum": 4,
          "title": "Wall Height",
          "type": "number"
        },
        "objective": {
          "enum": [
            "kill_all",
            "reach_reward"
          ],
          "title": "Objective",
          "type": "string"
        },
        "enemies": {
          "items": {
            "$ref": "#/$defs/EnemyGroup"
          },
          "maxItems": 4,
          "title": "Enemies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "width",
        "depth",
        "wall_height",
        "objective"
      ],
      "title": "ArenaChamber",
      "type": "object"
    },
