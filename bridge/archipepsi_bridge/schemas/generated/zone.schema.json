    "DoorAssignment": {
      "additionalProperties": false,
      "description": "One joining socket of one room instance, and what it does.\n\n`edge_id` is required unless the door is `SEALED` or `ZONE_EXIT`,\nand the edge it names must be `JOINED` \u2014 a `TRAVERSAL_ONLY` edge is\ncarried by a `PlugAssignment` and never by a door. `ZONE_EXIT` is\nthe Zone's own way out and names no edge at all: see `DoorUsage`.",
      "properties": {
        "socket_id": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Socket Id",
          "type": "string"
        },
        "usage": {
          "enum": [
            "USED",
            "LOCKED",
            "SEALED",
            "ZONE_EXIT"
          ],
          "title": "Usage",
          "type": "string"
        },
        "edge_id": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9_:]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "key_id": {
          "anyOf": [
