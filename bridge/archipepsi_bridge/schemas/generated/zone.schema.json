{
  "$defs": {
    "AffordanceFeature": {
      "additionalProperties": false,
      "description": "One optional world feature a Zone may offer (ECHOES.md \u00a713).\n\nOptional is the whole point. A feature may never lie on the mandatory\npath, host an AP reward, an exit or an objective \u2014 \u00a713.2, enforced by\n`validate_zone` rather than by good intentions \u2014 so a Zone with every\nfeature stripped out is still completable with the base kit. That is\nwhat makes affordances safe to generate against a campaign whose\ncapabilities the generator cannot fully predict.",
      "properties": {
        "tag": {
          "enum": [
            "grapple_anchor",
            "breakable_wall",
            "water_volume",
            "rail",
            "wind_volume",
            "bounce_pad",
            "moving_platform"
          ],
          "title": "Tag",
          "type": "string"
        },
        "at": {
          "default": [
            0.5,
            0.5
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "tag"
      ],
      "title": "AffordanceFeature",
      "type": "object"
    },
    "ArenaChamber": {
      "additionalProperties": false,
      "description": "Rectangular combat room. A boss room is an arena holding one brute.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "anyOf": [
            {
              "maximum": 89100030,
              "minimum": 89100001,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Location Id"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffordanceFeature"
          },
          "maxItems": 3,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "arena",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "maximum": 28,
          "minimum": 10,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "maximum": 28,
          "minimum": 10,
          "title": "Depth",
          "type": "number"
        },
        "wall_height": {
          "maximum": 8,
          "minimum": 4,
          "title": "Wall Height",
          "type": "number"
        },
        "objective": {
          "enum": [
            "kill_all",
            "reach_reward"
          ],
          "title": "Objective",
          "type": "string"
        },
        "enemies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnemyGroup"
          },
          "maxItems": 4,
          "title": "Enemies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "width",
        "depth",
        "wall_height",
        "objective"
      ],
      "title": "ArenaChamber",
      "type": "object"
    },
    "CorridorChamber": {
      "additionalProperties": false,
      "description": "Connector. Has no objective, so enemies here gate nothing.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "anyOf": [
            {
              "maximum": 89100030,
              "minimum": 89100001,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Location Id"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffordanceFeature"
          },
          "maxItems": 3,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "corridor",
          "title": "Type",
          "type": "string"
        },
        "length": {
          "maximum": 30,
          "minimum": 6,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "maximum": 10,
          "minimum": 4,
          "title": "Width",
          "type": "number"
        },
        "enemies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnemyGroup"
          },
          "maxItems": 4,
          "title": "Enemies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "length",
        "width"
      ],
      "title": "CorridorChamber",
      "type": "object"
    },
    "EnemyGroup": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "enum": [
            "melee",
            "ranged",
            "brute"
          ],
          "title": "Archetype",
          "type": "string"
        },
        "count": {
          "maximum": 8,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "archetype",
        "count"
      ],
      "title": "EnemyGroup",
      "type": "object"
    },
    "PlatformPathChamber": {
      "additionalProperties": false,
      "description": "Base-movement platforming.\n\n`gap_size` and `vertical_step` are bounded JOINTLY: the reachable gap\nshrinks as the landing rises. v0.4 bounded them independently, so both\ncould be maxed and the real margin was 1.17x rather than the 1.56x the\nflat-jump derivation advertised.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "anyOf": [
            {
              "maximum": 89100030,
              "minimum": 89100001,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Location Id"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffordanceFeature"
          },
          "maxItems": 3,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "platform_path",
          "title": "Type",
          "type": "string"
        },
        "segment_count": {
          "maximum": 8,
          "minimum": 3,
          "title": "Segment Count",
          "type": "integer"
        },
        "gap_size": {
          "maximum": 2.6,
          "minimum": 0.5,
          "title": "Gap Size",
          "type": "number"
        },
        "vertical_step": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Vertical Step",
          "type": "number"
        },
        "objective": {
          "const": "platform_to_goal",
          "default": "platform_to_goal",
          "title": "Objective",
          "type": "string"
        },
        "enemies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnemyGroup"
          },
          "maxItems": 2,
          "title": "Enemies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "segment_count",
        "gap_size",
        "vertical_step"
      ],
      "title": "PlatformPathChamber",
      "type": "object"
    },
    "TowerChamber": {
      "additionalProperties": false,
      "description": "Vertical traversal. The template always emits a base-movement route.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "anyOf": [
            {
              "maximum": 89100030,
              "minimum": 89100001,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Location Id"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffordanceFeature"
          },
          "maxItems": 3,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "tower",
          "title": "Type",
          "type": "string"
        },
        "floors": {
          "maximum": 5,
          "minimum": 2,
          "title": "Floors",
          "type": "integer"
        },
        "objective": {
          "enum": [
            "reach_reward",
            "kill_all"
          ],
          "title": "Objective",
          "type": "string"
        },
        "enemies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnemyGroup"
          },
          "maxItems": 4,
          "title": "Enemies",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "floors",
        "objective"
      ],
      "title": "TowerChamber",
      "type": "object"
    },
    "TreasureRoomChamber": {
      "additionalProperties": false,
      "description": "Small safe reward room. Exactly one reward, never enemies.",
      "properties": {
        "id": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        },
        "reward_location_id": {
          "maximum": 89100030,
          "minimum": 89100001,
          "title": "Reward Location Id",
          "type": "integer"
        },
        "features": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AffordanceFeature"
          },
          "maxItems": 3,
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "treasure_room",
          "title": "Type",
          "type": "string"
        },
        "objective": {
          "const": "reach_reward",
          "default": "reach_reward",
          "title": "Objective",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reward_location_id",
        "type"
      ],
      "title": "TreasureRoomChamber",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 7,
      "default": 7,
      "title": "Schema Version",
      "type": "integer"
    },
    "zone_id": {
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Zone Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "target_game": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Target Game",
      "type": "string"
    },
    "theme": {
      "enum": [
        "concrete_facility",
        "rusted_industrial",
        "neon_transit",
        "gothic_stone",
        "temple_ruin",
        "void_glitch"
      ],
      "title": "Theme",
      "type": "string"
    },
    "designer_note": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Designer Note"
    },
    "featured_echo_ids": {
      "default": [],
      "items": {
        "maxLength": 32,
        "pattern": "^echo_\\d+$",
        "type": "string"
      },
      "maxItems": 4,
      "title": "Featured Echo Ids",
      "type": "array"
    },
    "chambers": {
      "items": {
        "discriminator": {
          "mapping": {
            "arena": "#/$defs/ArenaChamber",
            "corridor": "#/$defs/CorridorChamber",
            "platform_path": "#/$defs/PlatformPathChamber",
            "tower": "#/$defs/TowerChamber",
            "treasure_room": "#/$defs/TreasureRoomChamber"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CorridorChamber"
          },
          {
            "$ref": "#/$defs/ArenaChamber"
          },
          {
            "$ref": "#/$defs/PlatformPathChamber"
          },
          {
            "$ref": "#/$defs/TowerChamber"
          },
          {
            "$ref": "#/$defs/TreasureRoomChamber"
          }
        ]
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Chambers",
      "type": "array"
    }
  },
  "required": [
    "zone_id",
    "display_name",
    "target_game",
    "theme",
    "chambers"
  ],
  "title": "Zone",
  "type": "object"
}
