{
  "$defs": {
    "ActivityPrimitive": {
      "additionalProperties": false,
      "description": "One instance of an activity family, with its difficulty dialled in.\n\nEpsilon picks the family and the numbers. It does not describe the\npuzzle in prose, because prose cannot be built and cannot be scored:\nan unimplemented tag counts for nothing (CAMPAIGN_SCALE.md 9), and\nthe way to guarantee that is to have no field it could put prose in.",
      "properties": {
        "kind": {
          "enum": [
            "switch_sequence",
            "timed_run",
            "target_challenge",
            "pressure_routing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "element_count": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Element Count",
          "type": "integer"
        },
        "time_limit": {
          "default": 0.0,
          "maximum": 120.0,
          "minimum": 0.0,
          "title": "Time Limit",
          "type": "number"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "requires": {
          "default": [],
          "items": {
            "enum": [
              "blink",
              "cross_long_gap",
              "grapple",
              "ranged_hit"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ActivityPrimitive",
      "type": "object"
    },
    "AffordanceFeature": {
      "additionalProperties": false,
      "description": "One optional world feature a Zone may offer (ECHOES.md \u00a713).\n\nOptional is the whole point. A feature may never lie on the mandatory\npath, host an AP reward, an exit or an objective \u2014 \u00a713.2, enforced by\n`validate_zone` rather than by good intentions \u2014 so a Zone with every\nfeature stripped out is still completable with the base kit. That is\nwhat makes affordances safe to generate against a campaign whose\ncapabilities the generator cannot fully predict.",
      "properties": {
        "tag": {
          "enum": [
            "grapple_anchor",
            "breakable_wall",
            "water_volume",
            "rail",
            "wind_volume",
            "bounce_pad",
            "moving_platform",
            "powered_door"
          ],
          "title": "Tag",
          "type": "string"
        },
        "at": {
          "default": [
            0.5,
            0.5
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "At",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "tag"
      ],
      "title": "AffordanceFeature",
      "type": "object"
    },
