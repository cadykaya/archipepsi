{
 "about": "The rest of the owner's demonstrations, driven through the real input path (Input.parse_input_event). Scripted, not hands-on.",
 "steps": [
  {"at": 0.3, "check": {"path": "equipment.count", "eq": 9, "why": "more candidates than fit: Echo A's drawer holds 9"}},
  {"check": {"path": "equipment.more.1", "eq": "3 MORE", "why": "the drawer says how many wait below the view"}},
  {"key": "Right"},
  {"after": 0.1, "key": "Down"}, {"after": 0.06, "key": "Down"}, {"after": 0.06, "key": "Down"}, {"after": 0.06, "key": "Down"},
  {"after": 0.06, "key": "Down"}, {"after": 0.06, "key": "Down"}, {"after": 0.06, "key": "Down"}, {"after": 0.06, "key": "Down"},
  {"after": 0.6, "check": {"path": "equipment.unfolded", "eq": "act_s_long", "why": "eight rapid Downs land on the last candidate"}},
  {"check": {"path": "equipment.card_inside", "eq": true, "why": "the drawer scrolled the whole unfolded card into view"}},
  {"check": {"path": "equipment.more.0", "eq": "6 MORE", "why": "and says how many are now above"}},
  {"check": {"path": "equipment.card_height", "gt": 400, "why": "the longest authored description (158 of MAX_TEXT_LEN 160) unfolds in full"}},
  {"key": "Enter"},
  {"after": 0.3, "check": {"path": "equipment.preview.echo_a", "eq": "act_s_long", "why": "a local preview to clear later"}},

  {"set": {"reduced": true}},
  {"after": 0.1, "key": "Up"},
  {"after": 0.02, "check": {"path": "busy", "eq": "false", "why": "reduced motion: the fold/unfold is a cut, nothing travels"}},
  {"check": {"path": "equipment.unfolded", "eq": "act_s_rod", "why": "and the next item is already open"}},
  {"key": "Q"},
  {"after": 0.02, "check": {"path": "front", "eq": "map", "why": "reduced motion: the turn to the Map is a cut"}},
  {"key": "BracketRight"},
  {"after": 0.02, "check": {"path": "map.picked", "eq": "c001", "why": "] picks the first known place"}},
  {"check": {"path": "map.zoom", "remember": "cut_zoom"}},
  {"after": 0.4, "check": {"path": "map.zoom", "same_as": "cut_zoom", "why": "reduced motion: the lens cuts to the pick, it does not glide"}},
  {"check": {"path": "map.pulse", "near": 1.0, "tol": 0.0001, "why": "reduced motion: the gate pulse (secondary motion) holds still"}},
  {"key": "Q"},
  {"after": 0.02, "check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "reduced motion: the thread is simply there, not cast"}},
  {"key": "Down"},
  {"after": 0.02, "check": {"path": "journal.thread.link.edge", "eq": "e:c005:c006", "why": "a new link: no rewind, the new thread at once"}},
  {"check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "fully drawn on the same frame"}},
  {"set": {"reduced": false}},

  {"key": "Down"}, {"after": 0.05, "key": "Up"},
  {"after": 0.02, "check": {"path": "journal.thread.drawn", "lt": 1.0, "why": "full motion: Down then Up at once interrupts the rewind"}},
  {"after": 0.9, "check": {"path": "journal.thread.link", "same_path": "journal.link", "why": "only the newest link is cast -- not the one left in between"}},
  {"check": {"path": "journal.thread.link.edge", "eq": "e:c005:c006", "why": "back on the passage it started from"}},
  {"check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "and it is cast in full"}},
  {"key": "Down"}, {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"},
  {"after": 0.9, "check": {"path": "journal.link.room", "eq": "c001", "why": "PLACES FOUND: a place links to its room"}},
  {"key": "Down"},
  {"after": 0.9, "check": {"path": "journal.link.room", "eq": "c002", "why": "the next place, the next room"}},
  {"check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "the thread reaches a place as well as a passage"}},
  {"key": "E"},
  {"after": 0.6, "check": {"path": "map.link.room", "eq": "c002", "why": "the Map rings the place the entry names"}},

  {"key": "C"},
  {"after": 0.5, "key": "PageUp"},
  {"after": 0.2, "check": {"path": "map.floor", "eq": 0, "why": "PgUp: your floor first (MapFace.step_floor)"}},
  {"key": "PageUp"},
  {"after": 0.2, "check": {"path": "map.floor", "eq": 1, "why": "PgUp: the floor above"}},
  {"key": "PageUp"},
  {"after": 0.2, "check": {"path": "map.floor", "eq": -1, "why": "past the top: every floor again"}},
  {"pad": "down"},
  {"after": 0.2, "check": {"path": "map.floor", "eq": 0, "why": "the d-pad steps floors too"}},
  {"pad": "down"},
  {"after": 0.2, "check": {"path": "map.floor", "eq": -1, "why": "past the bottom: every floor again"}},

  {"key": "BracketRight"}, {"after": 0.08, "key": "BracketRight"}, {"after": 0.08, "key": "BracketRight"},
  {"after": 0.08, "key": "BracketRight"}, {"after": 0.08, "key": "BracketRight"},
  {"after": 0.02, "check": {"path": "busy", "eq": "true", "why": "the lens is still gliding when the next ] lands"}},
  {"after": 0.6, "check": {"path": "map.picked", "eq": "c005", "why": "five rapid ] land on the fifth place"}},
  {"key": "Equal"}, {"after": 0.1, "key": "Equal"}, {"after": 0.1, "key": "Equal"},
  {"after": 0.6, "check": {"path": "journal.thread.inside", "eq": false, "why": "zoomed in on Arena 2, the linked place is off the view"}},
  {"check": {"path": "journal.thread.arrow", "eq": true, "why": "so the thread stops at the window's edge with an arrow"}},
  {"key": "C"},
  {"after": 0.6, "check": {"path": "journal.thread.inside", "eq": true, "why": "C: the overview brings it back into the window"}},
  {"check": {"path": "journal.thread.arrow", "eq": false, "why": "and the arrow goes"}},

  {"set": {"save": "latched"}},
  {"after": 0.3, "key": "BracketRight"},
  {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "latched, place 1: no tag covers another, the room, or leaves the window"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 2: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 3: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 4: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 5: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 6: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 7: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 8: no clash"}},
  {"key": "BracketRight"}, {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "place 9: no clash"}},
  {"check": {"path": "map.picked", "eq": "c009", "why": "the ninth place is Arena 4, on the top floor"}},
  {"key": "Left"}, {"after": 0.1, "key": "Left"}, {"after": 0.1, "key": "Left"},
  {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "orbited 45 degrees: the tags re-place, still no clash"}},
  {"key": "Up"}, {"after": 0.1, "key": "Up"},
  {"after": 0.6, "check": {"path": "map.tag_clashes", "eq": 0, "why": "tilted: still no clash"}},
  {"key": "Enter"},
  {"after": 0.6, "check": {"path": "map.expanded", "eq": true, "why": "ENTER: the long answer docks at the window's edge"}},
  {"check": {"path": "map.tag_clashes", "eq": 0, "why": "the short tags keep clear of the docked detail's side"}},
  {"check": {"path": "map.shift", "lt": 0, "why": "and the lens slides the miniature aside rather than covering it"}},
  {"key": "Enter"},
  {"after": 0.5, "check": {"path": "map.expanded", "eq": false, "why": "ENTER closes the long answer"}},

  {"key": "Q"},
  {"after": 0.6, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"},
  {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"},
  {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"},
  {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"},
  {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"}, {"after": 0.05, "key": "Down"},
  {"after": 0.9, "check": {"path": "journal.text", "contains": "latch held", "why": "latched: WHAT YOU DID HERE names the latch"}},
  {"check": {"path": "journal.link.edge", "eq": "e:c009:c010", "why": "bound to ITS connector, matched exactly"}},
  {"check": {"path": "map.link.edge", "eq": "e:c009:c010", "why": "the Map rings that passage"}},
  {"set": {"save": "walked"}},
  {"after": 0.3, "check": {"path": "journal.note", "eq": "THE PASSAGE YOU FOLLOWED IS NOT IN THE JOURNAL NOW.", "why": "a save where that passage is unknown: said, not silently re-pointed"}},
  {"check": {"path": "map.link", "lacks": "c009", "why": "and the Map shows no link into what this save does not know"}},

  {"key": "E"}, {"after": 0.6, "key": "E"}, {"after": 0.6, "key": "E"},
  {"after": 0.6, "check": {"path": "front", "eq": "settings", "why": "Settings/Pause is in the four-face order"}},
  {"check": {"path": "settings.focus", "eq": 0, "why": "on MOTION, Production's own option"}},
  {"key": "Right"},
  {"after": 0.1, "check": {"path": "reduced", "eq": true, "why": "MOTION: OFF is what MenuShell reads as reduced motion"}},
  {"key": "Right"},
  {"after": 0.1, "check": {"path": "reduced", "eq": false, "why": "and back to FULL"}},
  {"key": "Down"}, {"after": 0.1, "key": "Right"},
  {"after": 0.3, "check": {"path": "save", "eq": "progressed", "why": "REVIEW CONTROLS: SAMPLE SAVE steps to the next of Production's saves"}},
  {"key": "Down"}, {"after": 0.1, "key": "Right"},
  {"after": 0.3, "check": {"path": "equipment_variant", "eq": "base", "why": "EQUIPMENT SAMPLE: the fixture alone"}},
  {"check": {"path": "equipment.count", "lt": 9, "why": "without the seven authored layout-stress Echoes"}},
  {"key": "Right"},
  {"after": 0.3, "check": {"path": "equipment.count", "eq": 9, "why": "and with them again"}},
  {"key": "Down"}, {"after": 0.1, "key": "Right"},
  {"after": 0.2, "check": {"path": "prompts", "contains": "key:UP", "why": "PROMPTS: TEXT -- every symbol shows its readable fallback"}},
  {"check": {"path": "prompts", "lacks": "cap:arrow", "why": "and no symbol is left"}},
  {"pad": "down"},
  {"after": 0.2, "check": {"path": "prompts", "contains": "key:D-PAD", "why": "on the pad, text too"}},
  {"key": "Down"},
  {"after": 0.1, "key": "Up"},
  {"after": 0.1, "key": "Right"},
  {"after": 0.2, "check": {"path": "prompts", "contains": "cap:arrow_up", "why": "PROMPTS: SYMBOLS again"}},
  {"key": "Down"}, {"after": 0.1, "key": "Enter"},
  {"after": 0.3, "check": {"path": "equipment.preview", "empty": true, "why": "CLEAR EQUIP PREVIEWS drops every local preview; nothing was sent"}},

  {"pad": "rb"},
  {"after": 0.6, "check": {"path": "front", "eq": "journal", "why": "RB from Settings: the Journal"}},
  {"check": {"path": "device", "eq": "pad", "why": "the pad is the device"}},
  {"check": {"path": "prompts", "contains": "sym:pad_dpad", "why": "so the prompts are the pad's symbols"}},
  {"check": {"path": "journal.link", "empty": false, "why": "the Journal kept a focused link"}},
  {"mouse_page": [640, 400]},
  {"after": 0.05, "mouse_page": [700, 420]},
  {"after": 0.2, "check": {"path": "device", "eq": "kbm", "why": "moving the mouse hands the prompts back"}},
  {"check": {"path": "prompts", "contains": "sym:mouse_left", "why": "with the mouse's own symbol"}},
  {"check": {"path": "missing_where", "empty": true, "why": "no character the face lacks was asked for, in any of it"}},
  {"after": 0.1, "quit": true}
 ]
}
