{
 "about": "The core checks, driven through the real input path (Input.parse_input_event). Scripted, not hands-on.",
 "steps": [
  {"at": 0.3, "check": {"path": "front", "eq": "equipment", "why": "the menu opens on Equipment"}},
  {"check": {"path": "equipment.slot", "eq": "echo_a", "why": "the first key is Echo A"}},
  {"check": {"path": "equipment.unfolded", "eq": "act_lash", "why": "a key opens on what is seated on it"}},

  {"after": 0.1, "key": "Down"},
  {"after": 0.3, "check": {"path": "equipment.slot", "eq": "echo_b", "why": "Down: the next key"}},
  {"key": "Up"},
  {"after": 0.3, "check": {"path": "equipment.slot", "eq": "echo_a", "why": "Up: back to Echo A"}},

  {"key": "Right"},
  {"after": 0.05, "check": {"path": "equipment.zone", "eq": "drawer", "why": "Right: into the drawer"}},
  {"key": "Down"}, {"after": 0.04, "key": "Down"}, {"after": 0.04, "key": "Down"},
  {"after": 0.02, "check": {"path": "busy", "eq": "true", "why": "the route and the echoes are still travelling when the next press lands"}},
  {"after": 0.5, "check": {"path": "equipment.unfolded", "eq": "act_s_arc", "why": "three rapid presses land on the third item"}},

  {"key": "Enter"},
  {"after": 0.3, "check": {"path": "equipment.preview.echo_a", "eq": "act_s_arc", "why": "ENTER previews it on RMB -- locally"}},
  {"after": 0.05, "check": {"path": "equipment.order.3", "eq": "act_s_arc", "why": "a preview does not reorder the drawer"}},
  {"key": "Up"}, {"after": 0.05, "key": "Up"}, {"after": 0.05, "key": "Up"},
  {"after": 0.4, "check": {"path": "equipment.unfolded", "eq": "act_lash", "why": "the save's own occupant is still first in the drawer"}},
  {"key": "Enter"},
  {"after": 0.3, "check": {"path": "equipment.preview.echo_a", "eq": "<null>", "why": "ENTER on the save's item goes back to the save"}},

  {"after": 0.1, "check": {"path": "equipment.strip_positions", "remember": "strips"}},
  {"mouse_page": [420, 560]},
  {"after": 0.1, "mouse_page": [420, 610]},
  {"after": 0.3, "check": {"path": "equipment.strip_positions", "same_as": "strips", "why": "hover lights a station and moves NOTHING"}},
  {"check": {"path": "equipment.hover", "ne": "", "why": "hover did light a station"}},

  {"click_page": [420, 610]},
  {"after": 0.05, "check": {"path": "equipment.zone", "eq": "drawer", "why": "a click selects on the rail"}},
  {"check": {"path": "equipment.strip_positions", "same_as": "strips", "why": "and the rail does not move under the pointer"}},
  {"after": 0.5, "check": {"path": "equipment.unfolded", "ne": "act_lash", "why": "the clicked station's item is composed"}},

  {"wheel_page": [700, 400, 1]},
  {"after": 0.2, "check": {"path": "equipment.scroll", "gt": 0, "why": "the wheel scrolls the drawer"}},

  {"after": 0.2, "key": "Q"},
  {"after": 0.12, "check": {"path": "turning", "eq": "true", "why": "Q starts a turn left"}},
  {"key": "E"},
  {"after": 0.02, "check": {"path": "heading", "eq": 1, "why": "E mid-turn retargets back (the turn is interruptible)"}},
  {"after": 0.6, "check": {"path": "front", "eq": "equipment", "why": "and the eye is home"}},
  {"check": {"path": "yaw", "near": 1.5708, "tol": 0.001, "why": "exactly on Equipment's heading"}},

  {"key": "Q"},
  {"after": 0.6, "check": {"path": "front", "eq": "map", "why": "Q: Equipment -> Map"}},
  {"key": "BracketRight"},
  {"after": 0.1, "key": "BracketRight"},
  {"after": 0.5, "check": {"path": "map.picked", "eq": "c002", "why": "] ] : the second known place"}},
  {"key": "Enter"},
  {"after": 0.4, "check": {"path": "map.expanded", "eq": "true", "why": "ENTER: the long answer"}},
  {"key": "Enter"},
  {"after": 0.4, "check": {"path": "map.expanded", "eq": "false", "why": "ENTER again closes it"}},
  {"check": {"path": "map.zoom", "remember": "zoom_before"}},
  {"key": "Equal"},
  {"after": 0.5, "check": {"path": "map.zoom", "differs_from": "zoom_before", "why": "+ zooms (MapFace's key)"}},
  {"key": "Left"},
  {"after": 0.5, "check": {"path": "map.yaw", "near": -15.0, "tol": 0.01, "why": "Left orbits the whole miniature (MapFace's 15 deg)"}},
  {"click_room": "c003"},
  {"after": 0.5, "check": {"path": "map.picked", "eq": "c003", "why": "a still click picks the room under the pointer"}},
  {"check": {"path": "map.zoom", "remember": "zoom_kept"}},
  {"check": {"path": "map.yaw", "remember": "yaw_kept"}},

  {"key": "Q"},
  {"after": 0.6, "check": {"path": "front", "eq": "journal", "why": "Q: Map -> Journal"}},
  {"check": {"path": "journal.link.edge", "eq": "e:c002:c003", "why": "the first shut way is focused, bound to ITS connector"}},
  {"after": 0.6, "check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "the thread is cast"}},
  {"key": "Down"},
  {"after": 0.1, "check": {"path": "journal.link.edge", "eq": "e:c005:c006", "why": "Down: the next shut way, the next connector"}},
  {"after": 0.8, "check": {"path": "journal.thread.drawn", "near": 1.0, "tol": 0.001, "why": "rewound and recast"}},

  {"key": "E"},
  {"after": 0.6, "check": {"path": "front", "eq": "map", "why": "E: follow to the Map"}},
  {"check": {"path": "map.picked", "eq": "c003", "why": "the Map kept its pick"}},
  {"check": {"path": "map.zoom", "same_as": "zoom_kept", "why": "and its zoom"}},
  {"check": {"path": "map.yaw", "same_as": "yaw_kept", "why": "and its turn"}},
  {"check": {"path": "map.link.edge", "eq": "e:c005:c006", "why": "the Map rings the linked passage"}},
  {"key": "C"},
  {"after": 0.5, "check": {"path": "map.picked", "eq": "", "why": "C: overview, nothing picked"}},
  {"check": {"path": "map.zoom", "same_path": "map.fit", "why": "the whole known Zone"}},

  {"key": "Q"},
  {"after": 0.6, "set": {"save": "progressed"}},
  {"after": 0.2, "check": {"path": "journal.link.edge", "eq": "e:c005:c006", "why": "the save changes: the focus follows the SAME passage"}},
  {"check": {"path": "journal.note", "eq": "NOW OPEN.", "why": "and says what changed"}},
  {"set": {"save": "walked"}},

  {"set": {"reduced": true}},
  {"after": 0.1, "key": "E"},
  {"after": 0.02, "check": {"path": "turning", "eq": "false", "why": "reduced motion: a turn is a cut"}},
  {"check": {"path": "front", "eq": "map", "why": "and it arrived"}},
  {"check": {"path": "map.pulse", "near": 1.0, "tol": 0.0001, "why": "reduced motion: the gates hold still"}},
  {"after": 0.37, "check": {"path": "map.pulse", "near": 1.0, "tol": 0.0001, "why": "still, later"}},
  {"set": {"reduced": false}},
  {"after": 0.2, "check": {"path": "map.pulse", "ne": 1.0, "why": "full motion: they pulse (MapFace's 1.2 Hz)"}},

  {"pad": "rb"},
  {"after": 0.6, "check": {"path": "front", "eq": "equipment", "why": "RB: turn right (Map -> Equipment)"}},
  {"check": {"path": "device", "eq": "pad", "why": "the prompts follow the pad"}},
  {"pad": "left"},
  {"after": 0.1, "pad": "down"},
  {"after": 0.3, "check": {"path": "equipment.slot", "ne": "echo_a", "why": "the d-pad moves the keys"}},
  {"pad": "lb"},
  {"after": 0.6, "pad": "y"},
  {"after": 0.5, "check": {"path": "map.picked", "eq": "", "why": "Y: MapFace's recentre, the overview"}},

  {"key": "Escape"},
  {"after": 0.1, "check": {"path": "open", "eq": "false", "why": "ESC closes from any wall (MenuShell)"}},
  {"key": "Tab"},
  {"after": 0.1, "check": {"path": "open", "eq": "true", "why": "TAB opens it"}},
  {"check": {"path": "front", "eq": "equipment", "why": "on Equipment"}},
  {"check": {"path": "equipment.slot", "remember": "slot_kept"}},
  {"key": "Tab"},
  {"after": 0.1, "check": {"path": "open", "eq": "false", "why": "TAB on Equipment closes (MenuShell)"}},
  {"key": "Escape"},
  {"after": 0.1, "check": {"path": "front", "eq": "settings", "why": "ESC opens on Settings"}},
  {"key": "Tab"},
  {"after": 0.6, "check": {"path": "equipment.slot", "same_as": "slot_kept", "why": "Equipment kept its place across the close"}},

  {"set": {"text_prompts": true}},
  {"after": 0.1, "set": {"text_prompts": false}},
  {"after": 0.1, "check": {"path": "missing_where", "empty": true, "why": "no character the face lacks was asked for"}},
  {"after": 0.1, "quit": true}
 ]
}
