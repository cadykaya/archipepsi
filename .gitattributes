# Batch files need CRLF: some constructs break on LF under cmd.exe, and
# the failure looks like a corrupted script rather than a line-ending
# problem.
*.bat text eol=crlf
*.sh text eol=lf

# Godot writes LF on every platform, including Windows. Without this,
# Git on Windows (autocrlf=true, which GitHub Desktop sets by default)
# checks these out as CRLF, Godot rewrites them back to LF the moment it
# opens the project, and the player is told they have "edited files"
# they never touched -- with a `warning: LF will be replaced by CRLF`
# on top, which reads like corruption.
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.uid   text eol=lf
*.import text eol=lf
